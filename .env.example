# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_MAINTENANCE_MODE: set to "true" to show the maintenance screen in production.
# Leave as "false" for normal operation; preview/dev environments can keep it unset.
VITE_MAINTENANCE_MODE="false"

# Payment providers (public client config only; private secrets stay server-side)
# PayPhone Payment Box credentials for the storefront widget (token + store Id).
# These values are required by the Payphone JS SDK and are used client-side.
VITE_PAYPHONE_TOKEN=""
VITE_PAYPHONE_STORE_ID=""
VITE_PAYPHONE_CHECKOUT_URL=""

# PayPal JS SDK client ID for the dashboard checkout button.
# Use the live client ID for production, or the sandbox client ID for a sandbox-only environment.
VITE_PAYPAL_CLIENT_ID=""

# Server-side payment secrets (Supabase Edge Functions / Vercel secrets only)
# PAYPHONE_CLIENT_ID=""
# PAYPHONE_SECRET_KEY=""
# PAYPHONE_TOKEN=""
# PAYPHONE_ENCRYPTION_PASSWORD=""
# PAYPHONE_BASE_URL="https://pay.payphonetodoesposible.com"
# PAYPHONE_STORE_ID=""
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_BASE_URL="https://api-m.paypal.com"
